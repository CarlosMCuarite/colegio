# =============================================================================
# SIGE Backend — Variables de Entorno
# Copiar a .env para desarrollo local. NO subir el .env real al repositorio.
# En Render, estas mismas variables se escriben en el dashboard del
# servicio (o vía render.yaml + "sync: false" para que Render te las pida
# una sola vez) — nunca en un archivo dentro del repo.
#
# Esta lista se generó revisando el código real (grep de process.env), no
# es una lista genérica — si una variable no está aquí, el backend no la usa.
# =============================================================================

NODE_ENV="development"
PORT=4000

# Base de datos (Supabase → Settings → Database → Connection string)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase (Settings → API)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# CORS — URLs permitidas para llamar a este backend, separadas por coma
CORS_ORIGINS="http://localhost:3000"

# ⚠️ Códigos de recuperación de contraseña (Admin y SuperAdmin). El código
# tiene un valor de respaldo escrito en src/routes/auth.ts para que el
# sistema no se rompa si falta — pero ese valor de respaldo queda visible
# para cualquiera que vea el código fuente. CAMBIA esto antes de usar el
# sistema con datos reales.
ADMIN_RECOVERY_CODE=""
SUPERADMIN_RECOVERY_CODE=""

# ── Opcionales — el sistema funciona sin ellas ──────────────────────────────

# Nombres de bucket de Supabase Storage (si no las defines, usa estos por defecto)
# SUPABASE_STORAGE_BUCKET_AVATARES="avatares"
# SUPABASE_STORAGE_BUCKET_BACKUPS="backups"
# SUPABASE_STORAGE_BUCKET_DOCUMENTOS="documentos"
# SUPABASE_STORAGE_BUCKET_LOGOS="logos"
# SUPABASE_STORAGE_BUCKET_VOUCHERS="vouchers"

# Backups automáticos (si no las defines, corre cada hora y guarda 7 versiones)
# BACKUP_CRON="0 * * * *"
# BACKUP_MAX_VERSIONES=7

# Retención automática de auditoría. Los accesos son voluminosos y menos
# sensibles; las operaciones administrativas se conservan por más tiempo.
# AUDITORIA_AUTH_RETENCION_DIAS=90
# AUDITORIA_RETENCION_DIAS=730
# AUDITORIA_LIMPIEZA_CRON="15 4 * * *"

# Firebase Cloud Messaging — SOLO si quieres notificaciones push. Si faltan
# estas 3, el sistema sigue funcionando normal, simplemente sin push (ya
# queda avisado en los logs, no es un error).
# FIREBASE_PROJECT_ID="sige-[project]"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@sige-[project].iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Solo para crear el primer SuperAdmin corriendo `npm run db:seed` una vez —
# no hace falta en producción si ya tienes un SuperAdmin creado.
# SEED_SUPERADMIN_EMAIL="admin@sige.pe"
# SEED_SUPERADMIN_PASSWORD="cambia-esto"
