{
  "name": "sige-backend",
  "version": "1.0.0",
  "description": "SIGE — Sistema Integral de Gestión Escolar · Backend",
  "main": "src/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nodemon",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "ts-node src/seed.ts",
    "seed:demo": "ts-node src/seed-demo.ts",
    "seed:demo:academico": "ts-node src/seed-demo-academico.ts",
    "seed:demo:completo": "ts-node src/seed-demo-completo.ts",
    "seed:demo:eliminar": "ts-node src/seed-demo-eliminar.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@supabase/supabase-js": "^2.39.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.2",
    "winston": "^3.12.0",
    "zod": "^3.22.4",
    "archiver": "^7.0.0",
    "node-cron": "^3.0.3",
    "dayjs": "^1.11.10",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.25",
    "@types/uuid": "^9.0.8",
    "@types/archiver": "^6.0.2",
    "@types/node-cron": "^3.0.11",
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  }
}