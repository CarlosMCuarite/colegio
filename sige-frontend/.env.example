# =============================================================================
# SIGE Frontend — Variables de Entorno
# Copiar a .env.local para desarrollo local. NO subir el .env real.
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Opcional — cambia el nombre/subtítulo que se ve en el navegador y el login
# (si no las defines, usa "SIGE" y el nombre completo por defecto)
NEXT_PUBLIC_SYSTEM_NAME=SIGE
NEXT_PUBLIC_SYSTEM_SUBTITLE=Sistema Integral de Gestión Escolar

# Reservadas para uso futuro (llamar a Supabase directo desde el navegador)
# — hoy el frontend no las usa, todo pasa por NEXT_PUBLIC_API_URL. No hace
# falta definirlas para que el sistema funcione.
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
